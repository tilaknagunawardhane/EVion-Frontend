{
  "expo": {
    "scheme": "EVionFrontend",
    "name": "EVion-Frontend",
    "slug": "EVion-Frontend",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "assetBundlePatterns": [
      "**/*"
    ],
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "This app needs access to your location to show maps and nearby stations.",
        "ITSAppUsesNonExemptEncryption": false
      },
      "bundleIdentifier": "com.anonymous.EVionFrontend",
      "config": {
        "googleMapsApiKey": "AIzaSyAmKf5PrCaWDXe26SYUYdSD95Flgtod3fw"
      },
      "runtimeVersion": {
        "policy": "appVersion"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.anonymous.EVionFrontend",
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.CAMERA"
      ],
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyB3_MPgAsAVzyIWrhmWnIWzmBlusld8IW0"
        }
      },
      "runtimeVersion": "1.0.0"
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-dev-client",
        {
          "addGeneratedScheme": false
        }
      ],
      [
        "react-native-maps",
        {
          "googleMapsApiKey": "AIzaSyB3_MPgAsAVzyIWrhmWnIWzmBlusld8IW0"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow $(PRODUCT_NAME) to access your photos to attach images to reports."
        }
      ],
      "expo-secure-store",
      "expo-asset",
      "expo-mail-composer"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "bc38139b-764d-4f33-bcb0-fd7dd4a2a11a"
      },
      "openChargeMapApiKey": "2a12ca16-1591-4521-93d4-8dd3a8347925"
    },
    "updates": {
      "url": "https://u.expo.dev/bc38139b-764d-4f33-bcb0-fd7dd4a2a11a"
    },
    "owner": "tilaknagunawardhane"
  }
}
